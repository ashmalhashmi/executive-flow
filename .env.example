# Google Calendar import (optional)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase cloud sync (optional — laptop ↔ mobile auto sync)
# 1. https://supabase.com → New project (free)
# 2. SQL Editor → run supabase/schema.sql
# 3. Authentication → Providers → enable Google
# 4. Project Settings → API → copy URL + anon public key
# 5. Authentication → URL Configuration → add Site URL:
#    https://executive-flow-seven.vercel.app
#    and Redirect URL: https://executive-flow-seven.vercel.app/**
# 6. Add same keys in Vercel → Project → Settings → Environment Variables

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
