# Google Calendar import (optional)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase cloud sync (optional — laptop ↔ mobile auto sync)
# 1. https://supabase.com → New project (free)
# 2. SQL Editor → run supabase/schema.sql
# 3. Authentication → Providers → Email: ON (OTP / magic link)
#    Optional: Providers → Google → Enable + Client ID/Secret from Google Cloud
# 4. Project Settings → API → copy URL + anon public key
# 5. Authentication → URL Configuration → Site URL:
#    https://executive-flow-seven.vercel.app
#    Redirect URLs: https://executive-flow-seven.vercel.app/**
# 6. Add same keys in Vercel → Project → Settings → Environment Variables
#
# Mobile tip: app uses Email OTP (6-digit code) — no need to open magic link in browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Sheets auto backup (optional — har activity automatic sheet par)
# Easy setup: scripts/google-sheets-webhook.gs → Apps Script deploy → web app URL
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT/exec
VITE_GOOGLE_SHEET_VIEW_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Advanced: Vercel serverless API instead of Apps Script webhook
# VITE_GOOGLE_SHEETS_USE_API=1
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=...
# GOOGLE_SHEET_ID=...

# Contact Capture (Gemini paid tier recommended)
# 1. https://aistudio.google.com/apikey — billing-enabled project key
# 2. powershell -File scripts/setup-gemini-env.ps1 -Key "YOUR_KEY"
# 3. npx vercel deploy --prod --yes
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-lite

# Morning Meeting Board email — 8:00 AM Pakistan (Vercel cron: 03:00 UTC)
# 1. https://resend.com → API key
# 2. Vercel → Environment Variables (Production):
# RESEND_API_KEY=re_xxxxxxxx
# MEETING_BOARD_EMAIL_FROM=Executive Flow <onboarding@resend.dev>
# CRON_SECRET=any-long-random-string
# Optional simple mode (no UI): MEETING_BOARD_EMAIL_TO=you@example.com
# Optional cloud cron reads: SUPABASE_SERVICE_ROLE_KEY=...
# Optional Sheets fallback meetings: GOOGLE_SHEET_ID + service account

# Weekly Expenditure summary — Sunday 9:00 PM Pakistan (Vercel cron: 16:00 UTC Sunday)
# WEEKLY_EXPENDITURE_EMAIL_TO=you@example.com
# (falls back to MEETING_BOARD_EMAIL_TO if unset)
